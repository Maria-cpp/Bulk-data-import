# ===========================================
# Bulk Data Import - Backend Configuration
# ===========================================
# Copy this file to .env and update values

# Database Configuration
# Format: postgresql+asyncpg://user:password@host:port/database
DATABASE_URL=postgresql+asyncpg://postgres:your_password@localhost:5432/bulk_import_db

# File Upload Settings
BULK_IMPORT_MAX_FILE_SIZE=52428800          # 50 MB in bytes
BULK_IMPORT_PROCESSING_TIMEOUT=300           # 5 minutes in seconds
BULK_IMPORT_MAX_RETRIES=3                    # Max retry attempts for failed imports

# JWT Authentication
# IMPORTANT: Change this in production!
JWT_SECRET_KEY=your-secret-key-change-in-production
JWT_ALGORITHM=HS256

# Tesseract OCR Path (required for image extraction)
# Windows: C:\Program Files\Tesseract-OCR\tesseract.exe
# Linux/Docker: /usr/bin/tesseract
# macOS (Homebrew): /usr/local/bin/tesseract
TESSERACT_CMD=/usr/bin/tesseract

# Logging Configuration
# Levels: DEBUG, INFO, WARNING, ERROR, CRITICAL
LOG_LEVEL=INFO
LOG_FORMAT=json

# CORS Origins (JSON array format)
CORS_ORIGINS=["http://localhost:5173", "http://localhost:3000"]
